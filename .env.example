# === DLMM Bot Configuration ===
# Copy this to .env and fill in your values

# Solana RPC (use paid RPC like Helius/Quicknode for speed)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Wallet keypair file path (Solana CLI format: JSON array of bytes)
WALLET_KEY_PATH=./wallet.json

# Capital limits
MAX_TOTAL_SOL=5.0
MAX_PER_POSITION_SOL=0.5

# === Telegram Bot ===
# Create bot via @BotFather on Telegram, get token
TELEGRAM_BOT_TOKEN=
# Get your chat ID via @userinfobot or @getmyid_bot
TELEGRAM_CHAT_ID=
